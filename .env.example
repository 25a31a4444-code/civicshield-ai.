# CivicShield AI - Environment Configuration Example
# Copy this file to .env for production overrides

SECRET_KEY=civicshield-dev-secret-key-change-in-production-2026
FLASK_ENV=development
DEBUG=True
PORT=5000

# Database
DATABASE_PATH=civicshield.db

# Storage & Uploads
UPLOAD_FOLDER=static/uploads
MAX_CONTENT_LENGTH=16777216  # 16 MB max upload

# AI Service Configuration
ENABLE_AI_CLASSIFICATION=True
AI_CONFIDENCE_THRESHOLD=0.65
ENABLE_IMAGE_AUTHENTICITY=True

# OTP & Notifications
OTP_DEV_MODE=True
OTP_DEV_CODE=123456
SMS_PROVIDER=mock  # Options: mock, twilio, fast2sms
SMTP_ENABLED=False

# Disaster Mode Default
DISASTER_MODE_ENABLED=False
